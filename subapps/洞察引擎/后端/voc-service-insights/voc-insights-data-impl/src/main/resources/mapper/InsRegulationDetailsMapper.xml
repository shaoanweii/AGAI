<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.voc.service.insights.engine.data.mapper.InsRegulationDetailsMapper">

    <resultMap id="BaseResultMap" type="com.voc.service.insights.engine.data.entity.InsRegulationDetailEntity" >
        <result column="id" property="id" />
        <result column="regulation_id" property="regulationId" />
        <result column="field_name" property="fieldName" />
        <result column="variable_value" property="variableValue" />
        <result column="logical_operator" property="logicalOperator" />
        <result column="condition_type" property="conditionType" />
        <result column="condition_detail" property="conditionDetail" />
        <result column="detail_type" property="detailType" />
        <result column="status" property="status" />
        <result column="del_flag" property="delFlag" />
        <result column="create_time" property="createTime" />
        <result column="create_user" property="createUser" />
        <result column="serial_number" property="serialNumber"/>
    </resultMap>

    <sql id="Base_Column_List">
        id,
                regulation_id,
                field_name,
                variable_value,
                logical_operator,
                condition_type,
                condition_detail,
                detail_type,
                status,
                del_flag,
                create_time,
                create_user,
         serial_number
    </sql>


    <select id="findRegulationDetails" resultType="com.voc.service.insights.engine.data.entity.InsRegulationDetailEntity">
        select
            <include refid="Base_Column_List"/>
        from
         ins_regulation_detail
        where
        1=1
        <if test="regulationId !=null and regulationId !=''">
            and regulation_id = #{regulationId}
        </if>
        and del_flag = 0
        order by serial_number asc
    </select>

    <update id="deleteRegulationInfo">
        delete from ins_regulation_detail where regulation_id = #{regulationId}
    </update>

    <select id="findAllRegulationDetails" resultMap="BaseResultMap">
        select <include refid="Base_Column_List"/> from ins_regulation_detail where 1=1 and del_flag = 0 order by serial_number asc
    </select>

    <delete id="removeRegulationDetails">
        delete from ins_regulation_detail where regulation_id = #{regulationId}
    </delete>
</mapper>