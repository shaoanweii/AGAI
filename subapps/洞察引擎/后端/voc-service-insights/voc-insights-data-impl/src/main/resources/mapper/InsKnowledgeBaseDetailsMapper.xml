<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.voc.service.insights.engine.data.mapper.InsKnowledgeBaseDetailsMapper">

    <insert id="saveBatch">
        insert into ins_knowledge_base_details
            (id,knowledge_base_id,content,sentiment,intention,update_time,create_time,update_by,create_by,vector_id,subject,aspect,description,opinion,topic,business_tag,quality_tag,scenario_tag,collection_name,severity_level,input_batch_id,data_validity)
        values
        <foreach collection="details" item="item" separator=",">
           (#{item.id},
            #{item.knowledgeBaseId},
            #{item.content},
            #{item.sentiment},
            #{item.intention},
            #{item.updateTime},
            #{item.createTime},
            #{item.updateBy},
            #{item.createBy},
            #{item.vectorId},
            #{item.subject},
            #{item.aspect},
            #{item.description},
            #{item.opinion},
            #{item.topic},
            #{item.businessTag},
            #{item.qualityTag},
            #{item.scenarioTag},
            #{item.collectionName},
            #{item.severityLevel},
            #{item.inputBatchId},
            #{item.dataValidity}
            )
        </foreach>
    </insert>


    <!-- 批量更新 -->
    <update id="batchUpdate" parameterType="java.util.List">
        <foreach collection="list" item="item" index="index" open="" close="" separator=";">
            UPDATE ins_knowledge_base_details
            <set>
                vector_state = '1',
                vector_id = #{item.vectorId}
            </set>
            WHERE id = #{item.id}
        </foreach>
    </update>



</mapper>

