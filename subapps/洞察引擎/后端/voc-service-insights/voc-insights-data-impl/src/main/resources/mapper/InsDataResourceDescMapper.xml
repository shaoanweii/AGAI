<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.voc.service.insights.engine.data.mapper.InsDataResourceDescMapper">
    <resultMap type="com.voc.service.insights.engine.data.entity.InsDataResourceDescEntity" id="InsDataResourceDescMap">
        <result property="id" column="id" jdbcType="VARCHAR"/>
        <result property="resourceId" column="resource_id" jdbcType="VARCHAR"/>
        <result property="name" column="name" jdbcType="VARCHAR"/>
        <result property="status" column="status" jdbcType="VARCHAR"/>
        <result property="updateTime" column="update_time" jdbcType="TIMESTAMP"/>
        <result property="createTime" column="create_time" jdbcType="TIMESTAMP"/>
        <result property="updateBy" column="update_by" jdbcType="VARCHAR"/>
        <result property="createBy" column="create_by" jdbcType="VARCHAR"/>
    </resultMap>
    <select id="countByResourceIds" resultType="com.voc.service.insights.engine.data.entity.InsDataResourceDescEntity">
        SELECT
            resource_id,
            COUNT(id) AS cnt
        FROM ins_data_resource_desc
        WHERE 1=1
        <if test="resourceIds != null and resourceIds.size()>0">
           and resource_id IN
            <foreach item="item" collection="resourceIds" separator="," open="(" close=")" index="index">
                #{item}
            </foreach>
        </if>
        GROUP BY resource_id
    </select>
</mapper>

