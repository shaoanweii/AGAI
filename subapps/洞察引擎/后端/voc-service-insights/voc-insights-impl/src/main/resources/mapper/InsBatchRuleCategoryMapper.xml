<?xml version="1.0" encoding="UTF-8" ?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.voc.service.insights.engine.mapper.InsBatchRuleCategoryMapper">

    <!-- 基础结果映射 -->
    <resultMap id="BaseResultMap" type="com.voc.service.insights.engine.entity.InsBatchRuleCategoryEntity">
        <id column="id" property="id" />
        <result column="name" property="name" />
        <result column="parent_id" property="parentId" />
        <result column="type" property="type" />
        <result column="status" property="status" />
        <result column="sort_order" property="sortOrder" />
        <result column="operator" property="operator" />
        <result column="create_time" property="createTime" />
        <result column="update_time" property="updateTime" />
        <result column="del_flag" property="delFlag" />
    </resultMap>

    <!-- 根据父分类ID查询子分类列表 -->
    <select id="selectListByParentId" resultMap="BaseResultMap">
        SELECT
            id,
            name,
            parent_id,
            type,
            status,
            sort_order,
            operator,
            create_time,
            update_time,
            del_flag
        FROM
            ins_batch_rule_category
        WHERE
            del_flag = 0
            AND parent_id = #{parentId}
        ORDER BY
            sort_order ASC,
            create_time DESC
    </select>

    <!-- 根据父分类ID和名称模糊查询子分类列表 -->
    <select id="selectListByParentIdAndName" resultMap="BaseResultMap">
        SELECT
            id,
            name,
            parent_id,
            type,
            status,
            sort_order,
            operator,
            create_time,
            update_time,
            del_flag
        FROM
            ins_batch_rule_category
        WHERE
            del_flag = 0
            AND parent_id = #{parentId}
            <if test="name != null and name != ''">
                AND name LIKE CONCAT('%', #{name}, '%')
            </if>
        ORDER BY
            sort_order ASC,
            create_time DESC
    </select>

    <!-- 检查分类名称是否重复 -->
    <select id="checkCategoryName" resultType="java.lang.Integer">
        SELECT
            COUNT(*)
        FROM
            ins_batch_rule_category
        WHERE
            del_flag = 0
            AND name = #{name}
            AND parent_id = #{parentId}
            <if test="excludeId != null and excludeId != ''">
                AND id != #{excludeId}
            </if>
    </select>

    <!-- 根据分类ID查询是否有子分类 -->
    <select id="countChildren" resultType="java.lang.Integer">
        SELECT
            COUNT(*)
        FROM
            ins_batch_rule_category
        WHERE
            del_flag = 0
            AND parent_id = #{categoryId}
    </select>

    <!-- 查询所有分类（用于构建多级树） -->
    <select id="selectAllCategories" resultMap="BaseResultMap">
        SELECT
            id,
            name,
            parent_id,
            type,
            status,
            sort_order,
            operator,
            create_time,
            update_time,
            del_flag
        FROM
            ins_batch_rule_category
        WHERE
            del_flag = 0
        ORDER BY
            sort_order ASC,
            create_time DESC
    </select>

</mapper>
