    <!-- 批量更新：DTO集合，每条记录独立赋值，有值才更新 -->
    <update id="batchUpdateByDtoList">
        <!-- 先判断集合非空，避免WHERE IN空列表 -->
        <if test="dtoList != null and dtoList.size() > 0">
            UPDATE voc_ms_td.voc_anal_flow_model_tags_result_data_full
            <set>
                <!-- 1. 处理brand_code：增加兜底WHEN，确保CASE有至少一个分支 -->
                brand_code = CASE
                <!-- 兜底WHEN（永远不匹配），保证CASE语法合法 -->
                WHEN id = -1 THEN brand_code
                <foreach collection="dtoList" item="dto" separator="">
                    <if test="dto.brandCode != null and dto.brandCode != ''">
                        WHEN id = #{dto.id} THEN #{dto.brandCode}
                    </if>
                </foreach>
                <!-- 无匹配时保留原值 -->
                ELSE brand_code
                END,

                <!-- 2. 处理car_series_code -->
                car_series_code = CASE
                WHEN id = -1 THEN car_series_code
                <foreach collection="dtoList" item="dto" separator="">
                    <if test="dto.carSeriesCode != null and dto.carSeriesCode != ''">
                        WHEN id = #{dto.id} THEN #{dto.carSeriesCode}
                    </if>
                </foreach>
                ELSE car_series_code
                END,

                <!-- 3. 处理sentiment（数值类型） -->
                sentiment = CASE
                WHEN id = -1 THEN sentiment
                <foreach collection="dtoList" item="dto" separator="">
                    <if test="dto.sentiment != null">
                        WHEN id = #{dto.id} THEN #{dto.sentiment}
                    </if>
                </foreach>
                ELSE sentiment
                END,

                <!-- 4. 处理intention_type -->
                intention_type = CASE
                WHEN id = -1 THEN intention_type
                <foreach collection="dtoList" item="dto" separator="">
                    <if test="dto.intentionType != null and dto.intentionType != ''">
                        WHEN id = #{dto.id} THEN #{dto.intentionType}
                    </if>
                </foreach>
                ELSE intention_type
                END,

                <!-- 5. 处理topic -->
                topic = CASE
                WHEN id = -1 THEN topic
                <foreach collection="dtoList" item="dto" separator="">
                    <if test="dto.topic != null and dto.topic != ''">
                        WHEN id = #{dto.id} THEN #{dto.topic}
                    </if>
                </foreach>
                ELSE topic
                END,

                <!-- 6. 处理abandon（数值类型） -->
                abandon = CASE
                WHEN id = -1 THEN abandon
                <foreach collection="dtoList" item="dto" separator="">
                    <if test="dto.abandon != null">
                        WHEN id = #{dto.id} THEN #{dto.abandon}
                    </if>
                </foreach>
                ELSE abandon
                END,

                <!-- 兜底：更新时间 -->
                update_time = NOW()
            </set>
            <!-- 限定更新范围：仅更新DTO集合中包含的id -->
            WHERE id IN
            <foreach collection="dtoList" item="dto" open="(" separator="," close=")">
                #{dto.id}
            </foreach>
        </if>
    </update>


