    <select id="refreshViewData" resultType="java.lang.String">
        REFRESH MATERIALIZED VIEW sta_model_processed_data
    </select>


    <select id="querySoundsData" resultType="com.voc.service.insights.engine.vo.InsCqCaCorrectionDataVo">
        SELECT
        id,
        brand_name,
        car_series_name,
        original_text_scene,
        sentiment
        FROM
        voc_ms_td.voc_sentiment_annotations_results_v
        WHERE
        id IN
        <foreach item="item" collection="list" separator="," open="(" close=")" index="">
            #{item}
        </foreach>
        order by id
    </select>


    <select id="queryGroupData" resultType="com.voc.service.insights.engine.vo.InsCqCaCorrectionGroupDataVo">
        WITH base_data AS (
        SELECT
        brand_code,
        brand_name,
        car_series_code,
        car_series_name,
        sentiment,
        intention,
        topic_text,
        usage_scenario_first,
        usage_scenario_second
        FROM voc_sentiment_annotations_results_v
        WHERE  id IN
        <foreach item="item" collection="list" separator="," open="(" close=")" index="">
            #{item}
        </foreach>
        )

        -- 1. 单独统计 brand_code
        SELECT
        'brand_code' AS field_name,
        brand_name AS group_value,
        COUNT(*) AS count_num,
        CASE WHEN COUNT(*) > 1 THEN '是' ELSE '否' END AS is_greater_than_1
        FROM base_data
        GROUP BY brand_name

        UNION ALL

        -- 2. 单独统计 car_series_code
        SELECT
        'car_series_code' AS field_name,
        car_series_name AS group_value,
        COUNT(*) AS count_num,
        CASE WHEN COUNT(*) > 1 THEN '是' ELSE '否' END AS is_greater_than_1
        FROM base_data
        GROUP BY car_series_name

        UNION ALL

        -- 3. 单独统计 sentiment
        SELECT
        'sentiment' AS field_name,
        sentiment AS group_value,
        COUNT(*) AS count_num,
        CASE WHEN COUNT(*) > 1 THEN '是' ELSE '否' END AS is_greater_than_1
        FROM base_data
        GROUP BY sentiment

        UNION ALL

        -- 4. 单独统计 intention
        SELECT
        'intention' AS field_name,
        intention AS group_value,
        COUNT(*) AS count_num,
        CASE WHEN COUNT(*) > 1 THEN '是' ELSE '否' END AS is_greater_than_1
        FROM base_data
        GROUP BY intention

        UNION ALL

        -- 5. 单独统计 topic_text
        SELECT
        'topic_text' AS field_name,
        topic_text AS group_value,
        COUNT(*) AS count_num,
        CASE WHEN COUNT(*) > 1 THEN '是' ELSE '否' END AS is_greater_than_1
        FROM base_data
        GROUP BY topic_text

        UNION ALL

        -- 6. 联合统计 usage_scenario_first 和 usage_scenario_second
        SELECT
        'usage_scenario' AS field_name,
        CONCAT(usage_scenario_first, ' | ', usage_scenario_second) AS group_value,
        COUNT(*) AS count_num,
        CASE WHEN COUNT(*) > 1 THEN '是' ELSE '否' END AS is_greater_than_1
        FROM base_data
        GROUP BY usage_scenario_first, usage_scenario_second;
    </select>
