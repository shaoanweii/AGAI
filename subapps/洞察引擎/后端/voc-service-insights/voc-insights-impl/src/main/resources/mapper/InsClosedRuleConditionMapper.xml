<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.voc.service.insights.engine.mapper.InsClosedRuleConditionMapper">

    <!-- 通用查询映射结果 -->
    <resultMap id="BaseResultMap" type="com.voc.service.insights.engine.entity.InsClosedRuleConditionEntity">
        <id column="condition_id" property="conditionId"/>
        <result column="rule_id" property="ruleId"/>
        <result column="condition_type" property="conditionType"/>
        <result column="operator" property="operator"/>
        <result column="option" property="option"/>
        <result column="value_type" property="valueType"/>
        <result column="value" property="value"/>
        <result column="sort_order" property="sortOrder"/>
    </resultMap>

    <!-- 通用查询结果列 -->
    <sql id="Base_Column_List">
        condition_id, rule_id, condition_type, operator, `option`, value_type, `value`, sort_order
    </sql>

    <insert id="insertBatch"
            parameterType="java.util.List">
        insert into ins_closed_rule_condition (
        <include refid="Base_Column_List"/>
        )
        values
        <foreach collection="list" item="entity" separator=",">
            (
            #{entity.conditionId}, #{entity.ruleId}, #{entity.conditionType},
            #{entity.operator}, #{entity.option}, #{entity.valueType}, #{entity.value},
            #{entity.sortOrder}
            )
        </foreach>
    </insert>

    <select id="listByRuleId" resultMap="BaseResultMap" parameterType="java.lang.String">
        select
        <include refid="Base_Column_List"/>
        from ins_closed_rule_condition
        where rule_id = #{ruleId}
        order by sort_order
    </select>
    <select id="findQuoteCount" resultType="java.lang.Integer">
        select
            count(1)
        from
            ins_closed_rule_condition
        where `option` = 'lexicon'
        and
        <foreach item="id" index="index" collection="ruleId" open="(" separator="or" close=")">
            value like concat('%',#{id},'%')
        </foreach>
    </select>

</mapper>