{
  "name": "insights",
  "version": "0.0.0",
  "private": true,
  "scripts": {
    "dev": "vite",
    "dev:standalone": "vite --mode standalone",
    "build": "run-p type-check \"build-only {@}\" --",
    "build:portal": "vite build --mode agai --base=/apps/insight/ --outDir='../../../public/apps/insight' --emptyOutDir",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force",
    "build:dev": "run-p type-check && vite build --mode build_dev",
    "build:test": "run-p type-check && vite build --mode build_test",
    "build:rc": "run-p type-check && vite build --mode build_rc",
    "build:prod": "run-p type-check && vite build --mode production",
    "postbuild": "node ./build/build.js",
    "lint": "eslint . --ext .vue,.js,.ts,.jsx,.tsx --fix"
  },
  "dependencies": {
    "@element-plus/icons-vue": "^2.3.1",
    "await-to-js": "^3.0.0",
    "axios": "^1.16.0",
    "crypto-js": "^4.2.0",
    "dayjs": "^1.11.10",
    "echarts": "^6.1.0",
    "element-plus": "^2.13.7",
    "fast-glob": "^3.3.3",
    "lodash-es": "^4.18.1",
    "mitt": "^3.0.1",
    "pinia": "^2.1.7",
    "vue": "^3.4.15",
    "vue-router": "^4.2.5"
  },
  "devDependencies": {
    "@tsconfig/node20": "^20.1.2",
    "@types/crypto-js": "^4.2.2",
    "@types/lodash-es": "^4.17.12",
    "@types/node": "^20.11.10",
    "@typescript-eslint/eslint-plugin": "^6.7.0",
    "@typescript-eslint/parser": "^6.7.0",
    "@vitejs/plugin-vue": "^5.0.3",
    "@vitejs/plugin-vue-jsx": "^4.0.0",
    "@vue/tsconfig": "^0.5.1",
    "eslint": "^7.32.0",
    "eslint-config-prettier": "^8.6.0",
    "eslint-plugin-prettier": "^4.2.1",
    "eslint-plugin-vue": "^9.9.0",
    "less": "^4.2.0",
    "npm-run-all2": "^6.1.1",
    "prettier": "^2.8.8",
    "sass": "1.71.0",
    "typescript": "~5.9.3",
    "unplugin-auto-import": "^0.17.5",
    "unplugin-vue-components": "^0.26.0",
    "vite": "^6.4.3",
    "vite-plugin-eslint": "^1.8.1",
    "vite-plugin-vue-devtools": "^7.3.7",
    "vue-tsc": "^3.3.9"
  },
  "overrides": {
    "@typescript-eslint/typescript-estree": {
      "minimatch": "9.0.9"
    },
    "npm-run-all2": {
      "minimatch": "9.0.9"
    },
    "unplugin-vue-components": {
      "minimatch": "9.0.9"
    }
  }
}
