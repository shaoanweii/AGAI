{
  "extends": "@vue/tsconfig/tsconfig.dom.json",
  "include": [
    "env.d.ts",
    "src/**/*.ts",
    "src/***/**/*.ts",
    "src/***/**/*.d.ts",
    "src/**/*.tsx",
    "src/**/*.vue",
    "src/router/index.ts"
  ],
  "exclude": [
    "src/**/__tests__/*"
  ],
  "compilerOptions": {
    "jsx": "preserve",
    "jsxImportSource": "vue",
    "composite": true,
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "typeRoots": [
      "./node_modules/@types",
      "./src/types"
    ],
    "baseUrl": "./",
    "paths": {
      "@/*": [
        "src/*"
      ],
      "vite-plugin-eslint": [
        "node_modules/vite-plugin-eslint/dist/index.d.ts"
      ]
    },
    "noImplicitAny": false
  }
}